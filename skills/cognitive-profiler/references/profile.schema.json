{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ksprashu/agent-skill-forge/skills/cognitive-profiler/references/profile.schema.json",
  "title": "Communication Profile",
  "description": "Generated by scripts/profile_tool.py -- do not hand-edit. Run `profile_tool.py schema --check` to verify this file is current. JSON Schema cannot express the evidence invariant (observed claims must cite resolvable quote IDs); scripts/profile_tool.py validate does.",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "dimensions",
    "rules",
    "forbidden",
    "limits",
    "tone",
    "unknowns"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "generated": {
      "type": "string"
    },
    "evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "dimensions": {
      "type": "object",
      "required": [
        "visual_scaffolding",
        "text_density",
        "orientation_need",
        "metaphor_affinity",
        "decision_directness",
        "evidence_depth"
      ],
      "additionalProperties": false,
      "properties": {
        "visual_scaffolding": {
          "type": "object",
          "description": "Should structure (diagrams, tables) carry the explanation, or prose?",
          "required": [
            "band",
            "source",
            "evidence",
            "rationale"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "observed",
                "declared",
                "inferred"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "band": {
              "enum": [
                "low",
                "medium",
                "high",
                "unknown"
              ]
            },
            "rationale": {
              "type": "string"
            }
          }
        },
        "text_density": {
          "type": "object",
          "description": "How much unbroken prose can land before attention drops?",
          "required": [
            "band",
            "source",
            "evidence",
            "rationale"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "observed",
                "declared",
                "inferred"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "band": {
              "enum": [
                "low",
                "medium",
                "high",
                "unknown"
              ]
            },
            "rationale": {
              "type": "string"
            }
          }
        },
        "orientation_need": {
          "type": "object",
          "description": "Is framing needed before detail, or is it throat-clearing?",
          "required": [
            "band",
            "source",
            "evidence",
            "rationale"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "observed",
                "declared",
                "inferred"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "band": {
              "enum": [
                "low",
                "medium",
                "high",
                "unknown"
              ]
            },
            "rationale": {
              "type": "string"
            }
          }
        },
        "metaphor_affinity": {
          "type": "object",
          "description": "Do physical analogies help, or patronise?",
          "required": [
            "band",
            "source",
            "evidence",
            "rationale"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "observed",
                "declared",
                "inferred"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "band": {
              "enum": [
                "low",
                "medium",
                "high",
                "unknown"
              ]
            },
            "rationale": {
              "type": "string"
            }
          }
        },
        "decision_directness": {
          "type": "object",
          "description": "One recommendation, or the option space?",
          "required": [
            "band",
            "source",
            "evidence",
            "rationale"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "observed",
                "declared",
                "inferred"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "band": {
              "enum": [
                "low",
                "medium",
                "high",
                "unknown"
              ]
            },
            "rationale": {
              "type": "string"
            }
          }
        },
        "evidence_depth": {
          "type": "object",
          "description": "Headline answer, or the full cost and failure model?",
          "required": [
            "band",
            "source",
            "evidence",
            "rationale"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "observed",
                "declared",
                "inferred"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "band": {
              "enum": [
                "low",
                "medium",
                "high",
                "unknown"
              ]
            },
            "rationale": {
              "type": "string"
            }
          }
        }
      }
    },
    "tone": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "debugging": {
          "type": "string"
        },
        "learning": {
          "type": "string"
        },
        "review": {
          "type": "string"
        },
        "cost": {
          "type": "string"
        },
        "writing": {
          "type": "string"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "response_ceiling_words": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 50,
          "maximum": 5000
        },
        "sentences_per_bullet": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 10
        },
        "bullets_per_section": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2,
          "maximum": 20
        },
        "code_fold_threshold": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 3,
          "maximum": 200
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/rule"
      }
    },
    "forbidden": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/rule"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "rule": {
      "type": "object",
      "required": [
        "id",
        "scope",
        "directive",
        "source",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "observed",
            "declared",
            "inferred"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string",
          "pattern": "^R\\d+$"
        },
        "scope": {
          "enum": [
            "always",
            "architecture",
            "debugging",
            "learning",
            "review",
            "cost",
            "writing"
          ]
        },
        "directive": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
